# Lumen Copilot — local dev environment (ADR-0005).
# Copy to `.env` (git-ignored) and adjust. Safe local-dev DEFAULTS only — never real secrets.
# Host ports use the high `471xx` block so the stack won't collide with other local compose projects.
# To dodge a collision, change only the *_PORT here — never the code.

# --- Host ports (host:container) ---
FRONTEND_PORT=47180
BACKEND_PORT=47181
POSTGRES_PORT=47182
REDIS_PORT=47183
MINIO_PORT=47184
MINIO_CONSOLE_PORT=47185
OPENSEARCH_PORT=47186
WEB_SEARCH_PORT=47187

# --- Postgres (relational + pgvector) ---
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_local_dev
POSTGRES_DB=lumen

# --- MinIO (S3-compatible object storage) ---
# MinIO requires the root password to be >= 8 characters.
MINIO_ROOT_USER=lumen
MINIO_ROOT_PASSWORD=lumen_local_dev_secret

# --- Backend app config (consumed inside the container; uses compose service names) ---
DATABASE_URL=postgresql+asyncpg://lumen:lumen_local_dev@postgres:5432/lumen
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=lumen
S3_SECRET_KEY=lumen_local_dev_secret
S3_BUCKET=lumen-uploads
# OpenSearch — the single retrieval store (ADR-0010): BM25 lexical + kNN vectors.
# Inside compose the backend/worker reach it by service name; on the host (tests,
# dev outside compose) the default in app/core/config.py points at the mapped
# host port instead. Local dev runs with the security plugin disabled (no auth);
# the optional credentials are for secured deployments.
OPENSEARCH_URL=http://opensearch:9200
# OPENSEARCH_INDEX=lumen-chunks        # index holding one doc per chunk
# OPENSEARCH_TIMEOUT_SECONDS=10        # per-request timeout to the engine
# OPENSEARCH_USERNAME=                 # basic auth (empty = no auth, local default)
# OPENSEARCH_PASSWORD=
# Browser-reachable base URL for presigned GET/PUT URLs (#241). SigV4 signs the
# Host header, so this must be the URL the BROWSER fetches, not the in-network
# S3_ENDPOINT_URL above. docker-compose.yml defaults it to MinIO's published
# host port (http://localhost:47184); production sets its public object-store
# URL here. Unset (outside compose) ⇒ presign against S3_ENDPOINT_URL.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:47184
# Upload sandbox (CC-12 / #22). Optional — defaults live in app/core/config.py.
# S3_PRESIGN_TTL_SECONDS=900           # short TTL for presigned PUT/GET URLs
# MAX_UPLOAD_BYTES=52428800            # 50 MiB hard limit per object
# UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown   # comma-separated allowlist
# Document content (#28/#242). GET /documents/{id}/content: when true, 302 to a
# short-TTL presigned object URL (browser fetches straight from storage — needs a
# CORS-enabled object endpoint / CDN, since a browser fetch that follows the
# redirect to MinIO is a cross-origin read MinIO does not expose by default); when
# false, the API STREAMS the bytes inline (same-origin, no CORS — the viewer
# renders them). docker-compose.yml defaults this to "false" so previews work out
# of the box locally; prod behind a CORS-enabled endpoint/CDN can set it "true".
# DOCUMENT_CONTENT_REDIRECT=false
# Artifact store (CC-12 / #208) — files agents/runs *produce* (distinct from
# uploads). Optional — defaults live in app/core/config.py.
# MAX_ARTIFACT_BYTES=52428800          # 50 MiB hard cap per produced artifact
# ARTIFACT_ALLOWED_CONTENT_TYPES=text/csv,application/json,image/png,image/svg+xml,text/markdown,text/plain,text/html   # broader than uploads; comma-separated
# ARTIFACT_RETENTION_DAYS=              # empty = keep forever; N = purge N days after creation
# Cap (UTF-8 bytes) on GET /documents/{id}/text — the extracted-text surface the
# viewer uses for formats a browser can't render (#244). Over-cap responses are
# cut at a character boundary and flagged truncated. Default 2 MiB.
# DOCUMENT_TEXT_MAX_BYTES=2097152
ENVIRONMENT=local
LOG_LEVEL=info

# --- Identity & auth (CC-3 / spec 0004 §2.3). App-managed email+password. ---
# Symmetric signing secret for the access JWT. A dev default lives in
# app/core/config.py so the skeleton boots; OUTSIDE `local` the app refuses to
# start unless this is overridden (never ship the dev default).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256                  # HS256 for app-managed MVP; OIDC swaps it later
# JWT_ISSUER=lumen-copilot
# ACCESS_TOKEN_TTL_SECONDS=900         # short-lived access token; capped at 900 (<= 15 min)
# REFRESH_TOKEN_TTL_SECONDS=1209600    # rotating refresh token lifetime (default 14 days)

# --- Secrets vault master key (issue #209). Base64 of 32 bytes (AES-256). ---
# The per-tenant secrets vault encrypts stored third-party credentials (MCP auth
# tokens, a hosted web-search key, …) at rest with envelope encryption. A dev
# default lives in app/core/config.py so the skeleton boots; OUTSIDE `local` the
# app refuses to start unless this is overridden (never ship the dev key), the
# same fail-fast rule as JWT_SECRET. Mint one with:
#   python -c "from app.core.crypto import generate_master_key; print(generate_master_key())"
# SECRETS_ENCRYPTION_KEY=<base64-of-32-random-bytes>

# --- Managed-connector OAuth (ADR-0019 §1, issue #452). Defaults suit compose. ---
# TTL of the single-use server-side OAuth state record (<= 10 min by design).
# CONNECTOR_OAUTH_STATE_TTL_SECONDS=600
# Externally-reachable base of THIS API — the provider redirects the browser to
# {base}/api/v1/sources/oauth/callback, so it must be the URL the browser (and
# the provider's redirect-URI allowlist) sees, not an in-network address.
# CONNECTOR_OAUTH_REDIRECT_BASE_URL=http://localhost:47181
# The SPA sources route the callback 302s back to (the frozen ?connect=… target).
# CONNECTOR_OAUTH_FRONTEND_RETURN_URL=http://localhost:47180/sources

# --- Google Drive connector (ADR-0019 §5, issue #453) ---------------------------
# The platform's Google OAuth app registration (client id/secret). Blank lets the
# skeleton boot locally without a Google Cloud registration; OUTSIDE `local` the
# app refuses to start unless both are set (fail fast, ADR-0019 §1). Note:
# drive.readonly is a Google-RESTRICTED scope — production needs verification.
# GDRIVE_OAUTH_CLIENT_ID=
# GDRIVE_OAUTH_CLIENT_SECRET=
# Per-file download/export size cap (bytes); over-cap files are skipped + counted.
# GDRIVE_FETCH_MAX_BYTES=20971520
# Mirrored-ACL freshness window (hours): an ACL older than this is DENIED at
# retrieval (ADR-0019 §2) — also the worst-case revocation-to-enforcement bound.
# CONNECTOR_ACL_MAX_AGE_HOURS=24
# Periodic connector sync-poll interval (minutes): the Beat enqueues a sync for
# every connected managed source this often (per-tenant rate limit still applies).
# CONNECTOR_SYNC_INTERVAL_MINUTES=60
# How long a connector document may sit pending/processing before the sync poll
# re-drives its (idempotent) ingestion: recovery for a worker that died between
# a change page's commit and its post-commit ingestion (ADR-0019 §3). Keep it
# comfortably above a normal ingestion run.
# CONNECTOR_INGEST_RECOVERY_MINUTES=30
# Upper bound on documents one recovery sweep re-drives (bounded fan-out).
# CONNECTOR_INGEST_RECOVERY_BATCH=200

# --- LLM (LiteLLM gateway -> OpenRouter first). Leave key blank to boot the skeleton without LLM calls. ---
OPENROUTER_API_KEY=
# Gateway FALLBACK model for callers that pass model=None (in practice only the
# /search cited direct answer). This is NOT the chat default: tuning it does NOT
# speed up chat. The grounded chat answer resolves its model from the picker
# registry's is_default entry (see CHAT_MODEL_REGISTRY below — a FAST-tier model
# since #490), never from LLM_MODEL. Kept distinct on purpose so the two don't
# silently conflate.
LLM_MODEL=openrouter/openai/gpt-4o-mini
# Embeddings (issue #32). OpenRouter serves embeddings on an OpenAI-compatible
# endpoint; route them there (LiteLLM's native openrouter/ embedding route is
# unreliable). The openai/ prefix tells LiteLLM to use its OpenAI-compatible
# client; baai/bge-m3 is sent to LLM_EMBEDDING_API_BASE with the OpenRouter key.
LLM_EMBEDDING_MODEL=openai/baai/bge-m3
LLM_EMBEDDING_API_BASE=https://openrouter.ai/api/v1
# Output dim of the embedding model (bge-m3 = 1024) — pins the pgvector column.
LLM_EMBEDDING_DIMENSIONS=1024
# Per-request wall-clock budget handed to LiteLLM (batch/headless: ingestion,
# summaries, headless runs — a human is not waiting).
# LLM_TIMEOUT_SECONDS=60
# INTERACTIVE chat turn budget (#489): a live answer caps EACH resilient model
# turn (all same-route retries + backoffs + one failover) at this deadline, so a
# hung/unreachable provider surfaces a typed 503 within the budget instead of the
# ~182s retry cliff. Kept <=30s so worst-case time to a typed terminal is <=30s.
# LLM_INTERACTIVE_TIMEOUT_SECONDS=25
# Same-route attempts for one interactive turn (2 = one retry); the batch path
# keeps the fuller ladder. Bounded [1, 3].
# LLM_INTERACTIVE_MAX_ATTEMPTS=2

# --- Search-path cost/latency controls (#395) --------------------------------
# Process-local cache for repeated single-text query embeddings (per tenant).
LLM_EMBED_CACHE_MAX_ENTRIES=512
LLM_EMBED_CACHE_TTL_SECONDS=900
# Output ceiling for the short cited direct answer on /search.
SEARCH_DIRECT_ANSWER_MAX_TOKENS=300

# --- Ingestion (CC-5 / #21). Optional — defaults live in app/core/config.py. ---
# The Celery ingestion task turns an uploaded document into embedded chunks.
# Chunking is config, not a literal: window + overlap in characters (0 <= overlap
# < size). Embeddings are batched (one gateway call per batch). A transient fault
# retries with exponential backoff up to the cap, then the doc is marked failed.
# INGESTION_CHUNK_SIZE=1200            # target chunk window (chars)
# INGESTION_CHUNK_OVERLAP=200          # chars adjacent chunks share
# INGESTION_EMBED_BATCH_SIZE=64        # chunks per gateway embed() call
# INGESTION_MAX_RETRIES=3              # transient-fault retry cap before failed
# INGESTION_RETRY_BACKOFF_SECONDS=5    # base backoff (exponential: base * 2**n)

# Per-tenant connector fetch rate limit (ADR-0009 §3). Redis-backed fixed window
# enforced at the sync-enqueue boundary: at most MAX syncs per WINDOW seconds per
# tenant; an over-budget sync is DEFERRED (re-enqueued after BACKOFF), never
# dropped and never surfaced as an HTTP error (the /sources contract has no 429).
# SOURCE_SYNC_RATE_MAX_PER_WINDOW=30   # syncs admitted per window, per tenant
# SOURCE_SYNC_RATE_WINDOW_SECONDS=60   # window length (seconds)
# SOURCE_SYNC_RATE_BACKOFF_SECONDS=30  # countdown backoff when deferred

# Descriptive User-Agent sent on EVERY outbound web-connector fetch (ADR-0009 §3,
# #138). Many sites (e.g. Wikimedia) reject a UA-less request with a 4xx error
# *page*, which the connector would otherwise index as the document. Leave unset
# for a version-stamped default: LumenCopilot/<version> (+<repo-url>).
# WEB_USER_AGENT=LumenCopilot/0.0.1 (+https://github.com/k-sandhu/lumen-copilot)

# --- Web search: the `web_search` agent tool (ADR-0014, #219, risk:security) ---
# Backed by self-hosted SearXNG (OSS, no per-query key). The tool reaches OUTSIDE
# the tenant's corpus to the open internet, so it is OFF BY DEFAULT (governance,
# ADR-0014 §5): a disabled deploy returns a tool-result error, never a crash.
# Set true to enable web mode for this deploy (the assistant's knowledge_scope
# must also include `web` for the tool to be offered).
# WEB_SEARCH_ENABLED=false
# SearXNG JSON endpoint the adapter queries. Compose injects the internal
# http://searxng:8080 service address by default; a backend launched directly on
# the host uses app/core/config.py's mapped-port default instead. Set this only to
# override those topology-aware defaults (for example, a remote provider URL).
# WEB_SEARCH_ENDPOINT=https://search.example.com
# WEB_SEARCH_TIMEOUT_SECONDS=10        # query-leg wall-clock budget (adapter->SearXNG)
# WEB_SEARCH_DEFAULT_K=5               # results returned when the model omits k
# WEB_SEARCH_MAX_K=10                  # hard cap on requested k (clamped)
# WEB_SEARCH_FETCH_TOP_N=3             # top result pages to fetch+extract via the
#                                      #   SSRF chokepoint for cite-worthy passages
#                                      #   (0 = snippets only, no page fetch)
# Per-tenant web-search rate limit (ADR-0014 §3), reusing the Redis fixed-window
# limiter: at most MAX searches per WINDOW seconds per tenant; an over-budget
# search is throttled as a tool result, never an HTTP error. Distinct keyspace
# from the connector-sync limiter.
# WEB_SEARCH_RATE_MAX_PER_WINDOW=20
# WEB_SEARCH_RATE_WINDOW_SECONDS=60
# SearXNG server secret (compose passes it through). A local-dev placeholder lives
# in docker/searxng/settings.yml; override with a real random value for any
# non-local deployment (never ship the placeholder).
# SEARXNG_SECRET=change-me-to-a-long-random-string

# Chat-model picker registry (GET /models, issue #47). Curated, config-driven:
# the default seed is in code; override the WHOLE list here as a JSON array of
# {id,label,provider,tier,is_default,description?} (tier ∈ frontier|fast|oss).
# Must list >=1 model with EXACTLY ONE is_default, else the app refuses to boot.
# Leave unset to use the seed (frontier: claude-opus-4.8, gpt-5.5; fast:
# gemini-3.5-flash, claude-haiku-4.5; oss: deepseek-v3.2, qwen3.7-max). The
# shipped default (is_default) is the FAST claude-haiku-4.5 (#490 / #486): a
# frontier default set the floor for perceived chat speed. Frontier stays
# selectable per session / per tenant; it is just no longer the default.
# CHAT_MODEL_REGISTRY=[{"id":"anthropic/claude-opus-4.8","label":"Claude Opus 4.8","provider":"anthropic","tier":"frontier","is_default":true}]

# How long (seconds) the app lifespan waits for in-flight answer producers to
# cancel + drain on shutdown before proceeding to engine disposal (#156). The
# answer runtime runs off the request as a tracked asyncio.Task; on SIGTERM the
# lifespan cancels those tasks and awaits them bounded by this grace so a hung
# answer can't wedge uvicorn's graceful shutdown. Must be positive.
# CHAT_SHUTDOWN_GRACE_SECONDS=10       # graceful-shutdown drain budget for answers

# Follow-up suggestions after each answer (spec 0006, #429): one extra cheap
# completion on the session's model proposes up to CHAT_SUGGESTIONS_COUNT next
# questions (event:suggestions; chips + composer ghost in the UI). A nicety —
# failures/timeouts are silently skipped; disable to save the extra call.
# CHAT_SUGGESTIONS_ENABLED=true
# CHAT_SUGGESTIONS_COUNT=3             # 1-5 (contract cap)
# CHAT_SUGGESTIONS_TIMEOUT_SECONDS=8
# The dedicated model for the suggestions completion (#490). A FAST-tier id so
# the nicety never rides the answer's (possibly frontier) route. Empty = inherit
# the answer route (the pre-#490 behaviour).
# CHAT_SUGGESTIONS_MODEL=openrouter/anthropic/claude-haiku-4.5
# Suggestions are OFF the critical path (#489): the terminal `done` is published
# FIRST (declaring pendingSuggestions), then the suggestions arrive POST-terminal.
# This is how long the WS consumer holds the subscription open for that one
# trailing event:suggestions — must EXCEED CHAT_SUGGESTIONS_TIMEOUT_SECONDS (the
# margin covers scheduling + the publish after the completion returns).
# CHAT_SUGGESTIONS_GRACE_SECONDS=10

# Context-assembler budget (ADR-0016 §1, #410). The prompt is assembled under the
# model's input window: history trims oldest-first to fit; an oversize fixed prompt
# is a typed 422 refusal, never a provider crash. The fallback window is used when
# the model id is unknown to the local model map; the headroom is reserved for the
# completion. Both optional — sensible defaults in code.
# CONTEXT_FALLBACK_MAX_INPUT_TOKENS=100000   # conservative window for an unknown model
# CONTEXT_OUTPUT_HEADROOM_TOKENS=8000        # tokens reserved for the model's output
# In-answer tool-result compaction (ADR-0016 §3.1, #415): when a long tool loop
# would overflow the window, the oldest tool results are digested (rather than the
# answer refused). DIGEST_CHARS = real content kept per compacted result;
# CHUNK_SIZE = results cleared per pass (a chunk, so cache invalidation is rare).
# CONTEXT_COMPACTION_DIGEST_CHARS=1200
# CONTEXT_COMPACTION_CHUNK_SIZE=4
# PROACTIVE tool-result compaction (ADR-0016 §3.1 amendment, #491): the trigger
# above only fires OVER budget, which a frontier-sized window never reaches — so
# a superseded search result rode every later turn at full size. With this on,
# fit_transcript shrinks a tool result to a bounded head digest (capped at
# DIGEST_CHARS above) once it is BOTH superseded by a later tool group AND
# represented in citations; the newest tool group (evidence a pending call is
# about to reference) is always preserved, and cited evidence stays durable in
# the citation records. Default on for the chat answer path; a kill switch.
# CONTEXT_PROACTIVE_COMPACTION_ENABLED=true
# Concurrent tool execution (ADR-0016 §5, #412): how many of one turn's read-only
# tool calls run at once. Each executing call briefly holds its own DB session, so
# keep this under the engine pool size (concurrent answers multiply the draw).
# Validated to [1, 16]; 1 = the fully serial pre-#412 behavior.
# CHAT_TOOL_CONCURRENCY=4

# Streamed-text coalescing (#487): adjacent answer/narration chunks are merged
# into one WS envelope instead of one envelope per provider chunk (each envelope
# costs a Redis round-trip out and a client state commit in). Flushes on
# whichever comes first — CHARS accumulated or SECONDS elapsed — and always
# before any other envelope, so ordering and seq monotonicity are unchanged.
# Text is never altered: concatenating the deltas still yields the exact answer.
# CHARS=0 is the kill switch (restores one envelope per provider chunk).
# CHAT_TEXT_COALESCE_CHARS=160
# CHAT_TEXT_COALESCE_SECONDS=0.04

# Answer output ceiling (#488): bounds the grounded answer / forced-synthesis
# turn so answer length — and the tail of the streaming wait — cannot run away.
# finish_reason="length" then becomes an ordinary terminal handled by the one
# length continuation (ADR-0016 §4), capping a single answer at ~2× this value.
# 0 = unbounded (the pre-#488 shape).
# CHAT_ANSWER_MAX_TOKENS=1536

# Rolling session summary (ADR-0016 §3.2, #416): older turns roll into a
# persisted per-session summary (async, post-answer); the last KEEP_MESSAGES
# stay verbatim; the task no-ops until MIN_BATCH messages accumulate beyond the
# tail. SUMMARY_MODEL pins the summarizer. Empty (the default) = the DEDICATED
# FAST default (the registry is_default id, now FAST — #490) for a config
# session, so a background compaction task never inherits a frontier answer
# route; a per-tenant provider: session still summarizes through its own
# provider. A non-empty value is an explicit override (config credentials).
# #491: retuned from 8 + 4 to 4 + 2 so the FIRST compaction fires at ~turn 3
# (6 messages) instead of ~turn 7 (12 messages). The verbatim tail still keeps
# the last 2 full turns word-for-word; older turns roll into the summary.
# CHAT_SUMMARY_ENABLED=true
# CHAT_SUMMARY_KEEP_MESSAGES=4
# CHAT_SUMMARY_MIN_BATCH=2
# CHAT_SUMMARY_MODEL=

# Provider prompt-cache directives (ADR-0016 §2, #411): the gateway decorates
# outgoing chat turns per provider family — Anthropic-style cache_control
# breakpoints, OpenAI-style prompt_cache_key routing affinity (keyed by session).
# Off = the exact undirected wire (caching still happens implicitly where the
# provider does it on its own). Kill-switch only; no tuning knobs.
# Process-static: read once at startup — changing it requires an app restart
# (an in-flight request is never mutated; new processes pick up the new value).
# CHAT_PROMPT_CACHE_ENABLED=true

# Dynamic per-tenant scheduler (ADR-0015 §7, #236). celery-redbeat rides the
# EXISTING Redis broker (no new infra): its live schedule entries live under the key
# prefix, and the single `beat` compose service holds a Redis leader lock so only one
# fires. The `schedules` table (Postgres) is authoritative; Beat reconciles its
# entries from it on boot. All optional — sensible defaults in code.
# REDBEAT_KEY_PREFIX=lumen:redbeat:      # Redis namespace for derived schedule entries
# REDBEAT_LOCK_TIMEOUT_SECONDS=90        # Beat leader-lock timeout
# Per-tenant run-enqueue rate + concurrency caps (ADR-0015 §5), reusing the Redis
# fixed-window limiter (distinct keyspace): at most MAX enqueues per WINDOW seconds
# per tenant, and at most IN_FLIGHT simultaneous queued/running runs. An over-cap
# fire is deferred (never dropped); the schedule keeps ticking. Must be positive.
# RUN_RATE_MAX_PER_WINDOW=60
# RUN_RATE_WINDOW_SECONDS=60
# RUN_RATE_BACKOFF_SECONDS=30
# RUN_MAX_IN_FLIGHT_PER_TENANT=20
# Bounded retry-with-backoff for a TRANSIENT run fault (model/db/storage briefly
# unavailable) before the run reaches a terminal (ADR-0015 §5, E7-5 #239). A
# transient failure is re-driven up to MAX_RETRIES times with exponential backoff
# (BACKOFF * 2**attempt); on exhaustion the run reaches a queryable `failed` (never a
# silent drop). An escalation-worthy failure (ambiguity / restricted data / tool
# failure) is never retried — it escalates to a human immediately.
# RUN_MAX_RETRIES=3
# RUN_RETRY_BACKOFF_SECONDS=5

# --- Reusable sandbox code execution (ADR-0020, #457, risk:security) ------------
# The isolated Python code-execution sandbox — the HIGHEST-RISK capability in the
# program (adversarial-by-assumption model-authored code). The worker calls a
# dedicated `sandbox-runner` service over its internal API (ADR-0020 §2); the worker
# holds NO Docker socket — the socket lives ONLY in that one service.
#
# OFF BY DEFAULT (ADR-0013 §6, the kill-switch): with SANDBOX_ENABLED=false EVERY run
# is refused (status=denied, audited) and the sandbox never launches. Set true only
# for a deploy that has provisioned the runner + reviewed the isolation posture; the
# per-tenant admin enable (#233) layers on top.
# SANDBOX_ENABLED=false
# SANDBOX_RUNNER_URL=http://sandbox-runner:8000   # internal API (compose network only, no host port)
#
# SANDBOX_RUNNER_TOKEN — REQUIRED when SANDBOX_ENABLED=true (#508).
#
# The sandbox-runner is the single holder of the Docker socket, and socket authority
# is host-root-equivalent. Its API was previously unauthenticated on the shared
# compose network, so an SSRF in the backend — or any compromised sibling container —
# could have it execute arbitrary code. Every capability endpoint now requires this
# shared secret, and the runner REFUSES TO START without one.
#
# Set the SAME value for the API, the worker and the sandbox-runner: they read this
# one variable. A mismatch fails with `sandbox_runner_unauthorized`, which is a
# distinct reason code from "unavailable" precisely so the log tells you the service
# is up and only the credential is wrong.
#
# Generate one (never reuse another secret, never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Minimum 32 characters, enforced on both sides.
# SANDBOX_RUNNER_TOKEN=
#
# SANDBOX_PACKAGE_INDEX_URL — pin WHERE sandbox wheels are fetched from (#509).
#
# Read by the SANDBOX-RUNNER process (not the API), since it performs the fetch. This
# REPLACES the default index, so a configured mirror is exclusive — nothing falls back
# to public PyPI.
#
# ADR-0013 §3 conditions install-based package expansion on "an admin-allowlisted,
# hash-pinned internal mirror". This is the allowlisted-mirror half. **Hash verification
# is NOT implemented** — an attempt at it was removed because `--require-hashes` cannot
# be combined with command-line package arguments (verified against real pip). So the
# wheels are unverified whether or not you set this; see the runbook.
#
# Independent of this: a denied distribution can no longer arrive as a transitive
# dependency, and `code_runs.resolved_packages` records what actually installed.
#
# SANDBOX_PACKAGE_INDEX_URL=https://wheels.internal.example/simple
# The image model code EXECUTES in — built by sandbox_exec/Dockerfile (numpy, pandas,
# matplotlib, openpyxl on a digest-pinned python-slim). It is NOT the runner's own
# control-plane image: pointing this at lumen-sandbox-runner (the pre-#503 default)
# gave every run fastapi and no scientific stack. The runner drives the HOST Docker
# daemon, so this image must EXIST there — build it before enabling code execution:
#   docker compose --profile sandbox build sandbox-exec-image
# (docs/runbooks/sandbox-code-execution.md). Existing chat sandboxes keep the image
# they were created with until the sandbox is reset.
#
# PINNED, and validated at boot: an exact tag or a digest — never `:latest`, never a
# bare name. A digest reference (`lumen-sandbox-exec@sha256:<64 hex>`, optionally with
# the tag kept for readability: `lumen-sandbox-exec:0.1.1@sha256:<64 hex>`) is
# REQUIRED when SANDBOX_ENABLED=true and ENVIRONMENT is not `local`, because a tag is
# mutable on the daemon: whoever can retag it chooses what model-authored code runs
# in, with no deploy. In local dev the tag is accepted as trust-on-first-build — you
# built it yourself, on this daemon. Read the digest of what you just built with:
#   docker image inspect lumen-sandbox-exec:0.1.1 --format '{{index .RepoDigests 0}}'
# (a locally built image has no RepoDigest until it is pushed; use `{{.Id}}` and a
# registry-pushed reference for a real deploy).
# SANDBOX_IMAGE=lumen-sandbox-exec:0.1.1
# What that image ALREADY SHIPS, as comma-separated `name==version` pins. Requests
# for these succeed with NO install and NO network (issue #504) — override only when
# you run a custom execution image, and then keep it equal to that image's contents
# (backend/tests/test_sandbox_exec_image.py guards the shipped pair against drift).
#
# LIMITATION, stated plainly: anything NOT in that list is a real install. It needs
# (a) the package on the tenant's allowed_packages list (Admin → Code execution) AND
# (b) outbound network FROM THE sandbox-runner SERVICE, which downloads the wheels and
# copies them into the offline container. Model-authored code itself NEVER gets a
# network route (ADR-0020 §2/§3), and the per-tenant `egress_allowed` flag does not
# open one — do not enable egress expecting `pip install` to start working. On a
# deploy whose runner cannot reach an index, the pre-installed stack is what you get.
#
# SECOND LIMITATION, equally plain: those wheels come from the DEFAULT PUBLIC PyPI
# with no `--require-hashes` and no `--index-url` pin. ADR-0013 §3's "admin-allowlisted,
# hash-pinned internal mirror" is NOT implemented, so an allow-list grant trusts
# whatever that index serves today. A locked-down deploy withholds the runner's
# outbound network and lives on the pre-installed stack — and note that the DEFAULT
# posture is the opposite: compose puts `sandbox-runner` (the Docker-socket holder) on
# the default bridge network with unrestricted outbound internet, and closing that is
# the operator's job, not something this repository does for you.
#
# Deliberately shipped WITHOUT an assignment line: the default already mirrors the
# image, and an EMPTY value means "this image ships nothing", which refuses every
# `packages=[...]` request. Set it only for a custom image, in the comma form:
#   SANDBOX_PREINSTALLED_PACKAGES=numpy==2.5.1,pandas==3.0.5,matplotlib==3.11.1
# The OCI runtime, read from this one variable by BOTH the backend (which refuses to
# boot on anything but runsc outside ENVIRONMENT=local) and the `sandbox-runner`
# service (which launches containers with it). The runner takes the runtime from its
# OWN configuration, never from a request, so a caller cannot downgrade a gVisor deploy
# to runc for one session; a session that states a different runtime is REFUSED, so
# restart sandbox-runner too after changing this — otherwise code execution fails loudly
# instead of quietly running under the old runtime.
# SANDBOX_RUNTIME=runc                 # runc (Docker baseline) | runsc (gVisor prod hardening)
# WHAT THE SANDBOX DOES NOT BOUND, by default. ADR-0020 launches the execution
# container with NO cpu, memory, PID or disk limit and NO wall clock: one run_python
# call can allocate until the host is out of RAM, spin every core, fork-bomb, or fill
# /var/lib/docker, and explicit cancel/reset is the only recovery. That is a deliberate
# sponsor decision (ADR-0020 Consequences) and the design's largest residual operational
# risk — not an oversight, but read it before enabling code execution on a shared host.
#
# Turn this ON and the three values below stop being compatibility-only: they are sent
# to the runner, which applies them as --cpus / --memory / --pids-limit on the SESSION
# container. Session, not run (ADR-0020 §4): the container persists across turns, so a
# bound comfortable for one analysis turn can still kill a later turn in the same chat.
# Existing sandboxes keep the bounds they were created with — reset them to re-create.
# SANDBOX_SESSION_LIMITS_ENABLED=false
# SANDBOX_CPUS=1.0
# SANDBOX_MEMORY_BYTES=536870912
# SANDBOX_PIDS_LIMIT=128
# Compatibility-only regardless of the switch above: nothing enforces a wall clock
# (ADR-0020 replaced ADR-0013's timeout with explicit cancel/reset), and the runner's
# wire schema refuses the field rather than accept a promise no code keeps.
# SANDBOX_WALL_CLOCK_SECONDS=30
# ...with ONE exception, which is enforced: how many bytes of a run's output directory
# the runner reads into ITS OWN memory before it stops and reports partial collection.
# The runner is the single Docker-socket holder, so unbounded collection let one chat
# turn's huge file OOM the process every tenant's code execution depends on. Complete
# files up to the cap come back; one the cap cuts in half is dropped (never delivered
# corrupt) and the run's stderr says so. The runner clamps this to its own 64 MiB
# ceiling; lowering it only narrows collection. Default 32 MiB:
# SANDBOX_OUTPUT_BYTES_CAP=33554432
# SANDBOX_SCRATCH_BYTES=268435456
# SANDBOX_MAX_CONCURRENT_PER_TENANT=2
# SANDBOX_DAILY_RUNTIME_SECONDS_PER_TENANT=3600

# --- MCP client adapter + egress (ADR-0012, #225, risk:security) ---------------
# The remote MCP client (app/mcp/) connects to user-supplied MCP server endpoints,
# so — like the web connector — every outbound connection is SSRF-guarded
# (https-only, reject loopback/private/link-local/metadata on connect AND every
# redirect hop, IP-pinned) and per-tenant rate-limited. All optional; sensible
# defaults live in app/core/config.py.
# Which remote transports the adapter opens. Remote only (ADR-0012 §1); stdio is
# deferred behind the sandbox and is NOT a valid value (a stdio entry fails fast).
# MCP_ALLOWED_TRANSPORTS=streamable_http,sse
# MCP_CONNECT_TIMEOUT_SECONDS=15       # per-connect/handshake wall-clock budget
# MCP_CALL_TIMEOUT_SECONDS=30          # per tool-invocation / discovery / probe budget
# Per-tenant MCP egress rate limit (reuses the Redis fixed-window limiter, distinct
# keyspace): at most MAX connects per WINDOW seconds per tenant; over-budget is a
# contained tool-result error, never an HTTP error.
# MCP_RATE_MAX_PER_WINDOW=30
# MCP_RATE_WINDOW_SECONDS=60
# Optional admin endpoint allowlist (defence-in-depth): a comma-separated set of
# permitted MCP endpoint hosts. EMPTY = no allowlist (the SSRF guard is the
# mandatory control). It only NARROWS (deny-by-default on top of SSRF), never widens.
# MCP_ENDPOINT_ALLOWLIST=

# --- Frontend (Vite). The browser talks to the Vite dev server, which proxies /api and /ws to the backend
#     over the compose network, so these don't need to track BACKEND_PORT. ---
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
# Developer-only pages (issue #40): the in-app docs viewer (/docs) and the
# shipped-capabilities catalog (/features). OFF by default — they render internal
# docs/ADRs/specs the wireframe IA (ADR-0007) excludes from the product surface.
# This is a BUILD-TIME flag: with it OFF, `vite build` drops the dev-page chunks
# entirely (the docs viewer inlines every repo markdown file, so the bytes must
# not ship — static JS is fetchable by direct URL regardless of auth). Set true
# ONLY for internal builds; even then the pages require an authenticated session
# (the same guard as /documents). "true"/"1" enables; anything else is off.
VITE_ENABLE_DEV_PAGES=false
