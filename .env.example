# Lumen Copilot — local dev environment (ADR-0005).
# Copy to `.env` (git-ignored) and adjust. Safe local-dev DEFAULTS only — never real secrets.
# Host ports use the high `471xx` block so the stack won't collide with other local compose projects.
# To dodge a collision, change only the *_PORT here — never the code.

# --- Host ports (host:container) ---
FRONTEND_PORT=47180
BACKEND_PORT=47181
POSTGRES_PORT=47182
REDIS_PORT=47183
MINIO_PORT=47184
MINIO_CONSOLE_PORT=47185

# --- Postgres (relational + pgvector) ---
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_local_dev
POSTGRES_DB=lumen

# --- MinIO (S3-compatible object storage) ---
# MinIO requires the root password to be >= 8 characters.
MINIO_ROOT_USER=lumen
MINIO_ROOT_PASSWORD=lumen_local_dev_secret

# --- Backend app config (consumed inside the container; uses compose service names) ---
DATABASE_URL=postgresql+asyncpg://lumen:lumen_local_dev@postgres:5432/lumen
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=lumen
S3_SECRET_KEY=lumen_local_dev_secret
S3_BUCKET=lumen-uploads
# Upload sandbox (CC-12 / #22). Optional — defaults live in app/core/config.py.
# S3_PRESIGN_TTL_SECONDS=900           # short TTL for presigned PUT/GET URLs
# MAX_UPLOAD_BYTES=52428800            # 50 MiB hard limit per object
# UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown   # comma-separated allowlist
# Document content (#28). GET /documents/{id}/content responds 302 to a presigned
# GET URL when true (default); set false to stream the bytes inline instead.
# DOCUMENT_CONTENT_REDIRECT=true
ENVIRONMENT=local
LOG_LEVEL=info

# --- Identity & auth (CC-3 / spec 0004 §2.3). App-managed email+password. ---
# Symmetric signing secret for the access JWT. A dev default lives in
# app/core/config.py so the skeleton boots; OUTSIDE `local` the app refuses to
# start unless this is overridden (never ship the dev default).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256                  # HS256 for app-managed MVP; OIDC swaps it later
# JWT_ISSUER=lumen-copilot
# ACCESS_TOKEN_TTL_SECONDS=900         # short-lived access token; capped at 900 (<= 15 min)
# REFRESH_TOKEN_TTL_SECONDS=1209600    # rotating refresh token lifetime (default 14 days)

# --- LLM (LiteLLM gateway -> OpenRouter first). Leave key blank to boot the skeleton without LLM calls. ---
OPENROUTER_API_KEY=
# Default model id in LiteLLM/OpenRouter form. Configurable; not hardcoded in app.
LLM_MODEL=openrouter/openai/gpt-4o-mini
# Embeddings (issue #32). OpenRouter serves embeddings on an OpenAI-compatible
# endpoint; route them there (LiteLLM's native openrouter/ embedding route is
# unreliable). The openai/ prefix tells LiteLLM to use its OpenAI-compatible
# client; baai/bge-m3 is sent to LLM_EMBEDDING_API_BASE with the OpenRouter key.
LLM_EMBEDDING_MODEL=openai/baai/bge-m3
LLM_EMBEDDING_API_BASE=https://openrouter.ai/api/v1
# Output dim of the embedding model (bge-m3 = 1024) — pins the pgvector column.
LLM_EMBEDDING_DIMENSIONS=1024

# --- Ingestion (CC-5 / #21). Optional — defaults live in app/core/config.py. ---
# The Celery ingestion task turns an uploaded document into embedded chunks.
# Chunking is config, not a literal: window + overlap in characters (0 <= overlap
# < size). Embeddings are batched (one gateway call per batch). A transient fault
# retries with exponential backoff up to the cap, then the doc is marked failed.
# INGESTION_CHUNK_SIZE=1200            # target chunk window (chars)
# INGESTION_CHUNK_OVERLAP=200          # chars adjacent chunks share
# INGESTION_EMBED_BATCH_SIZE=64        # chunks per gateway embed() call
# INGESTION_MAX_RETRIES=3              # transient-fault retry cap before failed
# INGESTION_RETRY_BACKOFF_SECONDS=5    # base backoff (exponential: base * 2**n)

# Chat-model picker registry (GET /models, issue #47). Curated, config-driven:
# the default seed is in code; override the WHOLE list here as a JSON array of
# {id,label,provider,tier,is_default,description?} (tier ∈ frontier|fast|oss).
# Must list >=1 model with EXACTLY ONE is_default, else the app refuses to boot.
# Leave unset to use the seed (frontier: claude-opus-4.8, gpt-5.5; fast:
# gemini-3.5-flash, claude-haiku-4.5; oss: deepseek-v3.2, qwen3.7-max).
# CHAT_MODEL_REGISTRY=[{"id":"anthropic/claude-opus-4.8","label":"Claude Opus 4.8","provider":"anthropic","tier":"frontier","is_default":true}]

# --- Frontend (Vite). The browser talks to the Vite dev server, which proxies /api and /ws to the backend
#     over the compose network, so these don't need to track BACKEND_PORT. ---
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
# Developer-only pages (issue #40): the in-app docs viewer (/docs) and the
# shipped-capabilities catalog (/features). OFF by default — they render internal
# docs/ADRs/specs the wireframe IA (ADR-0007) excludes from the product surface.
# Set true ONLY for internal builds; even then the pages require an authenticated
# session (the same guard as /documents). "true"/"1" enables; anything else is off.
VITE_ENABLE_DEV_PAGES=false
