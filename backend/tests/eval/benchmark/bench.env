# Compose INTERPOLATION env for the isolated benchmark stack (#430).
# 472xx host-port block so `lumen-bench` never collides with the primary dev
# stack's 471xx (ADR-0005 isolation). Values below are the same public
# local-dev defaults as .env.example — nothing secret lives here; the
# OPENROUTER_API_KEY comes from the HOST environment (OS env wins over this
# file in compose interpolation).
FRONTEND_PORT=47280
BACKEND_PORT=47281
POSTGRES_PORT=47282
REDIS_PORT=47283
MINIO_PORT=47284
MINIO_CONSOLE_PORT=47285
OPENSEARCH_PORT=47286
WEB_SEARCH_PORT=47287

POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_local_dev
POSTGRES_DB=lumen
MINIO_ROOT_USER=lumen
MINIO_ROOT_PASSWORD=lumen_local_dev_secret
