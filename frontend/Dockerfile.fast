# Built SPA with no Node process, HMR or host filesystem watcher at runtime.
# Build from the repository root so opt-in dev docs have their real paths.
FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /repo/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
COPY docs/ /repo/docs/
COPY AGENTS.md README.md /repo/
COPY backend/AGENTS.md /repo/backend/AGENTS.md
COPY contracts/AGENTS.md /repo/contracts/AGENTS.md
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_WS_BASE_URL=/ws
ARG VITE_ENABLE_DEV_PAGES=false
RUN pnpm build

FROM nginx:1.27-alpine AS runtime
COPY frontend/nginx.fast.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/frontend/dist/ /usr/share/nginx/html/
EXPOSE 5173
