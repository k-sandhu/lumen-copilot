{
  "name": "@lumen-copilot/frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Lumen Copilot — React + Vite SPA (static). The only backend is FastAPI, reached through contracts/.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-query": "5.59.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.27.0",
    "rehype-highlight": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.16.13",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.14",
    "highlight.js": "11.10.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.2",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.3"
  }
}
